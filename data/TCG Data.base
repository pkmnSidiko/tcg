filters: file.folder == "TCG Data"
views:
  - type: table
    name: Table
    order:
      - file.name
      - Card Name
      - Set
      - "Card "
      - Rarity
      - Foil
      - Owned
      - Condition
      - Quantity
      - Market Value
      - Purchase Price
      - Target Buy Price
      - GainLoss
      - Notes
